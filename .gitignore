# Unity .gitignore file
# This file prevents uploading unnecessary and heavy files (Library, Temp, Logs...) to GitHub

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/_Recovery*

# Visual Studio / VS Code / Rider cache
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
*.stackdump

# OS generated
.DS_Store
Thumbs.db
